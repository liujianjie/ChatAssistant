<Window x:Class="ChatAssistant.Desktop.Views.ChatAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天助手" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <StackPanel>
                <TextBlock Text="💬 聊天助手" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="输入对方消息，获取符合你风格的回复建议" FontSize="12" Foreground="#E3F2FD" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：输入区 -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="对话历史（可选）" FontWeight="SemiBold" FontSize="14"/>

                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
                        <TextBox x:Name="HistoryBox" Height="120" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10"
                                 FontSize="13" Background="#FAFAFA"/>
                    </Border>

                    <TextBlock Grid.Row="4" Text="对方最新消息" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Top"/>

                    <Border Grid.Row="4" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Margin="0,30,0,0">
                        <TextBox x:Name="MessageBox" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10"
                                 FontSize="14"/>
                    </Border>

                    <Button Grid.Row="6" Content="生成回复建议" Height="45" FontSize="15"
                            Click="GenerateButton_Click"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- 右侧：回复建议 -->
            <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F5" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="💡 回复建议" FontSize="16" FontWeight="SemiBold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SuggestionsPanel" Margin="15">
                            <TextBlock Text="请在左侧输入对方的消息，点击按钮生成回复建议"
                                       FontSize="13" Foreground="#999" TextAlignment="Center"
                                       Margin="0,50,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#666"/>
        </Border>
    </Grid>
</Window>
