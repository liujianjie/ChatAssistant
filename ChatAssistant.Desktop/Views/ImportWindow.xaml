<Window x:Class="ChatAssistant.Desktop.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入聊天记录" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="导入聊天记录"
                   FontSize="20" FontWeight="Bold"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="选择文件:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathBox" Height="30" FontSize="14" IsReadOnly="True"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="浏览..." Width="80" Height="30"
                        Click="BrowseButton_Click"/>
            </Grid>
            <TextBlock Text="支持 .txt（微信导出格式）和 .csv 文件"
                       FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="对方名字:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ContactNameBox" Height="30" FontSize="14"/>
            <TextBlock Text="聊天记录中对方的昵称/名字"
                       FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="平台:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="PlatformBox" Height="30" FontSize="14" SelectedIndex="0">
                <ComboBoxItem Content="微信"/>
                <ComboBoxItem Content="Soul"/>
                <ComboBoxItem Content="小红书"/>
                <ComboBoxItem Content="其他"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="7" x:Name="StatusText" Text=""
                   Foreground="OrangeRed" FontSize="12" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Height="35" Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="导入" Width="80" Height="35"
                    Click="ImportButton_Click" IsDefault="True"
                    Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
