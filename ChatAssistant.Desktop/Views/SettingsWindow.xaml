<Window x:Class="ChatAssistant.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="350" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ChatAssistant 设置"
                   FontSize="20" FontWeight="Bold"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Claude API Key:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ApiKeyBox" Height="30" FontSize="14"
                         PasswordChanged="ApiKeyBox_PasswordChanged"/>
            <TextBlock Text="从 https://console.anthropic.com/ 获取"
                       FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="你的名字:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="UserNameBox" Height="30" FontSize="14"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="用于识别聊天记录中哪些是你发送的消息"
                       FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}"
                   Foreground="OrangeRed" FontSize="12"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Height="35" Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="保存" Width="80" Height="35"
                    Click="SaveButton_Click" IsDefault="True"
                    Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
